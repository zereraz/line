{
  "name": "@zereraz/line",
  "version": "0.0.1",
  "description": "Linear-inspired project management CLI tool",
  "main": "index.ts",
  "module": "index.ts",
  "type": "module",
  "author": "Zereraz",
  "license": "MIT",
  "keywords": ["linear", "cli", "project-management", "issues", "productivity"],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zereraz/line.git"
  },
  "bin": {
    "line": "./index.ts"
  },
  "scripts": {
    "dev": "bun --hot index.ts",
    "build": "bun build.ts",
    "build:current": "bun build index.ts --compile --outfile=./dist/line",
    "build:all": "bun build.ts",
    "start": "bun index.ts",
    "mcp-server": "bun src/mcp-server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "install-global": "bun link",
    "uninstall-global": "bun unlink",
    "prepublishOnly": "bun run test && bun run build:all"
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "CLAUDE_AGENT_GUIDE.md",
    "CLAUDE.md"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "react-devtools-core": "^6.1.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ink": "^6.0.1",
    "ink-spinner": "^5.0.0"
  }
}
